# The pre-commit hook and the scripts it runs are executed by sh. With CRLF endings the shebang
# line ends in a carriage return and the interpreter is not found, so the gate silently stops
# being a gate on any clone with core.autocrlf enabled -- which is the default on Windows.
*.sh text eol=lf
.githooks/* text eol=lf
gradlew text eol=lf

# The firebase CLI uploads the WORKING TREE bytes, so a rules file that arrives CRLF on one
# clone and LF on another publishes two different rulesets and two different checksums for the
# same content. storage.rules is pinned by sha256 in the deploy evidence (and its contract block
# is the ruleset F-a measured), so its line endings are part of the artifact, not a local
# preference. firestore.rules is deliberately left alone: it is already live as CRLF, and
# renormalising it here would silently change what the next Firestore deploy publishes.
storage.rules text eol=lf
storage.denyall.rules text eol=lf
