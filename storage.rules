rules_version = '2';

// OPTIQON Voice — Cloud Storage rules for the Mission D case-attachment path.
//
// The ruleset F-a verified live on 2026-09-11 against the real Cloud Storage Rules engine
// (`docs/F_A_STORAGE_RULES_VERIFICATION_2026-09-11.md`) is the base of the block below. FS-1
// tightened it, and the text is therefore NO LONGER byte-identical to what F-a measured:
//
//   * `allow read` is split into `allow get` and `allow list: if false`. Listing goes
//     through Firestore, where the attachment documents already are.
//   * create requires a non-empty object, an upload inside 72 hours of the attachment
//     document, and no custom metadata — which is what closes a client-chosen
//     `firebaseStorageDownloadTokens`. A download token is served without these rules.
//
// None of the three adds a Firestore document: they read `request.*` or the attachment
// document already paid for. The two-document ceiling is a property of the text, though,
// not of the intent, so the changed block must be probed live again before it is relied on
// (FS-1 P2). The emulator enforces no ceiling at all and proves nothing about it.
//
// What F-a established, and what the block depends on:
//
//   * The engine allows at most TWO DISTINCT Firestore documents per evaluation, and
//     repeated `firestore.get()` on those two is free (8 calls / 2 documents PASSED,
//     3 documents and 5 documents both DENIED, deterministic over three runs).
//   * Every allow statement below therefore reads exactly two documents: the attachment
//     document plus one users/ document — the owner's on the owner paths, the caller's
//     own on the admin path. The two liveness sources are never paid for in the same
//     evaluation, which is why admin read is a separate `allow`.
//   * Each allow opens with its uid or claim comparison, BEFORE any `firestore.get()`.
//     That order is what keeps an evaluation that runs both get-allows at two documents:
//     a non-owner never reaches owner(), a non-admin never reaches me(). Keep it first.
//   * `config/limits.uploadsEnabled` is deliberately absent. It gates reservations on the
//     Firestore side; spending it again on the byte path would cost the document that
//     revocation needs.
//   * `liveAdmin()` is written in positive form so an incomplete admin mirror raises an
//     evaluation error and denies. F-a probes C11 and C13b confirmed it fails closed.
//
// The one deny flag every path checks is the attachment's `deleteRequestedAt` — owner
// delete, admin delete, retention and account deletion all set that one field
// (`firestore.rules`, attachments). A client never updates or deletes an object.
//
// NOT YET DEPLOYED. `gs://optiqon-voice-47498-eun2` exists and is linked to Firebase, but
// the release it carries is `storage.denyall.rules`. This file reaches it only through
// `firebase deploy --only storage:feedback` behind `scripts/deploy/storage-guard.mjs`, and
// only as a separately approved provider Gate.
service firebase.storage {
  match /b/{bucket}/o {

    match /case-attachments/{ownerUid}/{caseId}/{aid} {

      // Document 1 of 2 on every path.
      function att() {
        return firestore.get(/databases/(default)/documents/cases/$(caseId)/attachments/$(aid)).data;
      }

      // Document 2 on the owner paths. Keyed by the *path* segment, which has already
      // been compared against the token uid before this is ever reached.
      function owner() {
        return firestore.get(/databases/(default)/documents/users/$(ownerUid)).data;
      }

      // Document 2 on the admin path: the calling principal's own users/ document.
      function me() {
        return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      }

      // Mirrors firestore.rules:51-56 isApproved(), minus signedIn().
      function liveOwner() {
        return request.auth.token.email_verified == true
          && owner().status == 'approved'
          && owner().email == request.auth.token.email;
      }

      // Carries both limbs of firestore.rules:68-70 isReader() out of one document.
      // `adminActive` is in positive form on purpose: a missing field makes the
      // expression error, and an errored condition denies. An incomplete mirror fails
      // closed, never open.
      function liveAdmin() {
        return request.auth.token.email_verified == true
          && me().status == 'approved'
          && me().email == request.auth.token.email
          && me().adminActive == true
          && (!('adminActiveUntil' in me()) || me().adminActiveUntil > request.time);
      }

      // OWNER GET — distinct documents: users/{ownerUid}, attachment. (2 of 2)
      allow get: if request.auth != null
        && request.auth.uid == ownerUid
        && liveOwner()
        && !('deleteRequestedAt' in att());

      // ADMIN GET — distinct documents: users/{request.auth.uid}, attachment. (2 of 2)
      // Kept as its own allow statement so the two liveness sources are never paid for
      // in the same evaluation, and so each path can be tested on its own.
      allow get: if request.auth != null
        && request.auth.token.admin == true
        && liveAdmin()
        && !('deleteRequestedAt' in att());

      // No listing of a prefix, by anyone. Firestore holds the index.
      allow list: if false;

      // OWNER CREATE — distinct documents: users/{ownerUid}, attachment. (2 of 2)
      allow create: if request.auth != null
        && request.auth.uid == ownerUid
        && liveOwner()
        && resource == null
        && att().ownerUid == ownerUid
        && att().caseId == caseId
        && !('deleteRequestedAt' in att())
        && request.time < att().createdAt + duration.value(72, 'h')
        && request.resource.size > 0
        && request.resource.size <= att().maxBytes
        && request.resource.size <= 2097152
        && request.resource.contentType.matches('image/(png|jpeg|webp)')
        && (request.resource.metadata == null || request.resource.metadata.size() == 0);

      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
